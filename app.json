{
  "expo": {
    "name": "AiAstrology",
    "slug": "expoAiAstrology",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.kapernikrs.aiastrology",
      "buildNumber": "6",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photo library so you can upload images to your profile and events.",
        "NSCameraUsageDescription": "We need access to your camera so you can take photos directly in the app.",
        "NSLocationWhenInUseUsageDescription": "We need access to your location to show events near you.",
        "NSUserTrackingUsageDescription": "We use your device identifier to deliver more relevant ads.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./android/app/google-services.json",
      "package": "com.kapernikrs.aiastrology",
      "versionCode": 6
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.728122372039-a6jj9godm62p3o7vov8f7q5psjfppiu7"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4139428747088857~8392254625",
          "iosAppId": "ca-app-pub-4139428747088857~9092275002"
        }
      ],
      "./plugins/remove-read-media-permissions",
      "expo-apple-authentication",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "d1def0ec-9920-48b9-9084-f37fabbd67e1"
      }
    }
  }
}
